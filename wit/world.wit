package uffe:onedrive-davfs@0.1.0;

/// A WebDAV server compiled to wasm32-wasip2 that fronts OneDrive via
/// Microsoft Graph. Mounted by the kernel's davfs2 client -- no FUSE in
/// the sandbox. Runs under `wasmtime serve`.
world onedrive-davfs {
  include wasi:http/proxy@0.2.12;

  import wasi:filesystem/preopens@0.2.12;
  import wasi:filesystem/types@0.2.12;
  import wasi:cli/environment@0.2.12;
}
