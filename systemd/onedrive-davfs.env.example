# onedrive-davfs environment file.
# Install as ~/.config/onedrive-davfs/env with mode 600 (see the unit file).

# Azure AD app (client) ID. Required for token refresh.
ONEDRIVE_CLIENT_ID=REPLACE_ME

# Tenant: "common" for personal + work accounts, "consumers", or a tenant ID.
ONEDRIVE_TENANT_ID=common

# OAuth scopes kept consistent across device-code login, browser/PKCE login,
# and daemon refresh. Add Sites.Read.All only when you need SharePoint site
# discovery.
ONEDRIVE_SCOPES="offline_access Files.ReadWrite.All User.Read"

# Graph drive selector: "me/drive", "users/<id>/drive", "groups/<id>/drive",
# "sites/<id>/drive", "drives/<id>", or a plain drive ID.
ONEDRIVE_DRIVE_BASE=me/drive

# REQUIRED. Shared secret davfs2 sends as the HTTP Basic password. Must be at
# least 16 characters and not a placeholder. Generate with:
#   openssl rand -base64 32
# and put the same value in ~/.davfs2/secrets:
#   http://127.0.0.1:8765/ daemon <secret>
ONEDRIVE_BASIC_AUTH_SECRET=REPLACE_ME

# Local metadata index (PROPFIND/HEAD). Set to 0 to always hit Graph.
ONEDRIVE_INDEX_ENABLED=1

# Max Graph /delta pages and wall-clock budget per POST /_sync tick.
ONEDRIVE_SYNC_MAX_PAGES=8
ONEDRIVE_SYNC_BUDGET_MS=20000
