# onedrive-davfs user unit.
#
# Serves the WebDAV component compiled to wasm32-wasip2 via the native
# `onedrive-davfs-host` Wasmtime embedder. All OAuth/network I/O still
# happens through `wasi:http`, but the host now enforces the guest env/fs
# capabilities, outbound HTTPS policy, request serialization, and store
# limits explicitly.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp systemd/onedrive-davfs.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now onedrive-davfs.service
#
# Configuration is read from a chmod-600 environment file (never from
# Environment= lines in this unit, which would be world-readable and show
# up in `systemctl --user show`):
#   install -m 700 -d ~/.config/onedrive-davfs
#   install -m 600 systemd/onedrive-davfs.env.example ~/.config/onedrive-davfs/env
#   $EDITOR ~/.config/onedrive-davfs/env
#
# NOTE: the native host does not inherit its whole environment into the
# guest. It forwards only the documented OneDrive variables below and
# preopens only the state directory as `/state`.
#
# Variables (see onedrive-davfs.env.example):
#   ONEDRIVE_CLIENT_ID          Azure AD app (client) ID (needed for refresh)
#   ONEDRIVE_TENANT_ID          defaults to "common" if unset
#   ONEDRIVE_DRIVE_BASE         defaults to "me/drive" if unset
#   ONEDRIVE_BASIC_AUTH_SECRET  REQUIRED shared secret (>= 16 chars) that
#                               davfs2 must send as the HTTP Basic password.
#                               The daemon refuses to serve without it.

[Unit]
Description=onedrive-davfs (Wasm WebDAV server for OneDrive via Microsoft Graph)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
EnvironmentFile=%h/.config/onedrive-davfs/env
ExecStart=%h/.local/bin/onedrive-davfs-host \
    --addr 127.0.0.1:8765 \
    --state-dir %h/.local/state/onedrive-davfs \
    --component %h/.local/share/onedrive-davfs/onedrive_davfs.wasm
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
