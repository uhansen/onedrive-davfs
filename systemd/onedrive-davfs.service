# onedrive-davfs user unit.
#
# Serves the WebDAV component compiled to wasm32-wasip2 via `wasmtime
# serve`. All OAuth/network I/O happens inside this process (through
# wasi:http) -- nothing runs as root, and the process only has access to
# the one preopened state directory below.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp systemd/onedrive-davfs.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now onedrive-davfs.service
#
# Configuration is read from a chmod-600 environment file (never from
# Environment= lines in this unit, which would be world-readable and show
# up in `systemctl --user show`):
#   install -m 700 -d ~/.config/onedrive-davfs
#   install -m 600 systemd/onedrive-davfs.env.example ~/.config/onedrive-davfs/env
#   $EDITOR ~/.config/onedrive-davfs/env
#
# NOTE: `wasmtime serve` does NOT inherit the host environment into the
# guest; each variable must be named with `--env NAME` on ExecStart below.
#
# Variables (see onedrive-davfs.env.example):
#   ONEDRIVE_CLIENT_ID          Azure AD app (client) ID (needed for refresh)
#   ONEDRIVE_TENANT_ID          defaults to "common" if unset
#   ONEDRIVE_DRIVE_BASE         defaults to "me/drive" if unset
#   ONEDRIVE_BASIC_AUTH_SECRET  REQUIRED shared secret (>= 16 chars) that
#                               davfs2 must send as the HTTP Basic password.
#                               The daemon refuses to serve without it.

[Unit]
Description=onedrive-davfs (Wasm WebDAV server for OneDrive via Microsoft Graph)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
EnvironmentFile=%h/.config/onedrive-davfs/env
ExecStart=%h/.local/bin/wasmtime serve \
    -S cli=y \
    --env ONEDRIVE_CLIENT_ID --env ONEDRIVE_TENANT_ID \
    --env ONEDRIVE_DRIVE_BASE --env ONEDRIVE_BASIC_AUTH_SECRET \
    --addr 127.0.0.1:8765 \
    --dir %h/.local/state/onedrive-davfs::/state \
    %h/.local/share/onedrive-davfs/onedrive_davfs.wasm
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
