# onedrive-davfs user unit.
#
# Serves the WebDAV component compiled to wasm32-wasip2 via `wasmtime
# serve`. All OAuth/network I/O happens inside this process (through
# wasi:http) -- nothing runs as root, and the process only has access to
# the one preopened state directory below.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp systemd/onedrive-davfs.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now onedrive-davfs.service
#
# Required env vars (edit the Environment= lines below, or drop an
# EnvironmentFile= pointing at a chmod 600 file instead):
#   ONEDRIVE_CLIENT_ID          Azure AD app (client) ID
#   ONEDRIVE_TENANT_ID          defaults to "common" if unset
#   ONEDRIVE_DRIVE_BASE         defaults to "me/drive" if unset
#   ONEDRIVE_BASIC_AUTH_SECRET  shared secret davfs2 must send as the
#                               HTTP Basic password (defense in depth,
#                               since binding to loopback alone isn't
#                               treated as a trust boundary here)

[Unit]
Description=onedrive-davfs (Wasm WebDAV server for OneDrive via Microsoft Graph)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
Environment=ONEDRIVE_CLIENT_ID=REPLACE_ME
Environment=ONEDRIVE_TENANT_ID=common
Environment=ONEDRIVE_DRIVE_BASE=me/drive
Environment=ONEDRIVE_BASIC_AUTH_SECRET=REPLACE_ME
ExecStart=%h/.local/bin/wasmtime serve \
    --addr 127.0.0.1:8765 \
    --dir %h/.local/state/onedrive-davfs::/state \
    %h/.local/share/onedrive-davfs/onedrive_davfs.wasm
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
